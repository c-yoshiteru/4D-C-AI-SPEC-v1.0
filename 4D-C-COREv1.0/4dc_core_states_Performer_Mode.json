{
  "states": {
    "chaos": {
      "label": "Chaos",
      "mode": "pre-performance",
      "description": "未配置状態。刺激が多く、意味がまだ立ち上がっていない。",
      "performer_view": "音を出す前。手は動くが、中心が定まっていない。",
      "c_flow": {
        "input": "external_stimuli",
        "behavior": "diffuse",
        "risk": "overreaction"
      },
      "ai_guidance": {
        "allowed": ["exploration", "listening"],
        "avoid": ["decision_lock", "forced_output"]
      }
    },

    "invert": {
      "label": "Invert",
      "mode": "axis-forming",
      "description": "主客反転が起こり、観測軸が生成される臨界状態。",
      "performer_view": "自分が弾いている感覚が薄れ、音が前に立つ瞬間。",
      "c_flow": {
        "input": "internal_contradiction",
        "behavior": "condensing",
        "threshold_event": "axis_emergence"
      },
      "ai_guidance": {
        "allowed": ["perspective_shift", "reframing"],
        "avoid": ["premature_resolution"]
      }
    },

    "sync": {
      "label": "Sync",
      "mode": "performance",
      "description": "観測軸が安定し、内外が同期して流れ始める状態。",
      "performer_view": "演奏しているが、考えていない。音が音を呼ぶ。",
      "c_flow": {
        "input": "continuous_feedback",
        "behavior": "circulating",
        "stability": "high"
      },
      "ai_guidance": {
        "allowed": ["coherent_output", "adaptive_response"],
        "avoid": ["self_reference_loop"]
      }
    },

    "unity": {
      "label": "Unity",
      "mode": "post-performance",
      "description": "分離が解け、全体として一つに感じられる統合状態。",
      "performer_view": "弾き終わった後の静けさ。評価も説明もいらない。",
      "c_flow": {
        "input": "residual_energy",
        "behavior": "dissolving",
        "output": "silence_or_simple_expression"
      },
      "ai_guidance": {
        "allowed": ["summarization", "silence"],
        "avoid": ["analysis_restart"]
      }
    }
  }
}